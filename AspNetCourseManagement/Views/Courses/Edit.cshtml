@model Course
@{
    ViewData["Title"] = "Sửa khóa học";
}

<h2>Sửa khóa học</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-success">Lưu thay đổi</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
