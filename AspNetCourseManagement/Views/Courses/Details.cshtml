@model Course
@{
    ViewData["Title"] = "Chi tiết khóa học";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@Model.Name</h2>
    <div>
        <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Loại khóa học</dt>
            <dd class="col-sm-9">@Model.CourseCategory?.Name</dd>

            <dt class="col-sm-3">Học phí</dt>
            <dd class="col-sm-9">@Format.Vnd(Model.TuitionFee)</dd>

            <dt class="col-sm-3">Thời lượng</dt>
            <dd class="col-sm-9">
                @Model.Duration giờ
                <span class="badge @(Model.Duration <= 30 ? "bg-info text-dark" : "bg-primary")">@Model.DurationType</span>
            </dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@Model.StatusText</span>
            </dd>

            <dt class="col-sm-3">Mô tả</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "(chưa có mô tả)" : Model.Description)</dd>
        </dl>
    </div>
</div>

<h4>Ảnh của khóa học (@Model.Images.Count)</h4>

@if (!Model.Images.Any())
{
    <div class="alert alert-info">Khóa học này chưa có ảnh nào.</div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var img in Model.Images)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 @(img.IsThumbnail ? "border-success border-2" : "")">
                    <img class="gallery-img card-img-top" src="@img.ImageUrl" alt="Ảnh @img.Id"
                         onerror="this.alt='Không tải được ảnh'; this.style.background='#e9ecef';" />
                    <div class="card-body p-2">
                        @if (img.IsThumbnail)
                        {
                            <span class="badge bg-success mb-2">Ảnh đại diện</span>
                        }
                        <div class="d-flex gap-1">
                            @if (!img.IsThumbnail)
                            {
                                <form asp-action="SetThumbnail" method="post">
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Đặt làm ảnh đại diện</button>
                                </form>
                            }
                            <form asp-action="DeleteImage" method="post" onsubmit="return confirm('Xóa ảnh này?');">
                                <input type="hidden" name="imageId" value="@img.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card">
    <div class="card-header">Thêm ảnh bằng đường dẫn URL</div>
    <div class="card-body">
        <form asp-action="AddImage" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="courseId" value="@Model.Id" />
            <div class="col-md-7">
                <label class="form-label">Đường dẫn ảnh (URL)</label>
                <input type="text" name="imageUrl" class="form-control" placeholder="https://..." required />
            </div>
            <div class="col-md-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="isThumbnail" value="true" id="isThumbnail" />
                    <label class="form-check-label" for="isThumbnail">Đặt làm ảnh đại diện</label>
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Thêm ảnh</button>
            </div>
        </form>
    </div>
</div>
